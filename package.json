{
  "name": "athar-web-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest run",
    "doctor": "node tools/project-doctor/doctor.mjs --current",
    "doctor:branches": "node tools/project-doctor/doctor.mjs --all-branches",
    "doctor:self-test": "node tools/project-doctor/self-test.mjs",
    "doctor:apply-fix": "node tools/project-doctor/apply-safe-fix.mjs",
    "cloudflare:doctor": "node tools/cloudflare-doctor/cloudflare-doctor.mjs",
    "cloudflare:doctor:self-test": "node tools/cloudflare-doctor/cloudflare-doctor.mjs --self-test"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
